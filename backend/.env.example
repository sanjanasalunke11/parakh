# Copy this file to .env in the same folder (backend/.env) and fill in
# any keys you have. Every value below has a working offline fallback,
# so Parakh runs even with this file completely empty.

# ---- Database ----
# MySQL (recommended, matches production schema in database/schema.sql):
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/parakh
# Or, for zero-setup local development, comment the line above and use:
# DATABASE_URL=sqlite:///./parakh.db

# ---- LLM provider (claim extraction + verification reasoning) ----
# anthropic = call Claude for structured extraction/verification
# groq      = call Groq (fast Llama models) for structured extraction/verification
# mock      = fully offline, deterministic rule-based fallback
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Evidence search provider ----
# tavily = live web search tuned for AI agents (https://tavily.com)
# mock   = offline curated demo evidence set
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
MAX_EVIDENCE_RESULTS=6

# ---- Semantic similarity / embeddings ----
# sentence_transformer = real local sentence embeddings (downloads a small model on first run)
# hashing               = zero-dependency deterministic fallback
EMBEDDING_PROVIDER=sentence_transformer
SIMILARITY_THRESHOLD=0.85
SEMANTIC_SCAN_LIMIT=3000

# ---- OCR ----
# Path to tesseract.exe on Windows if it's not on PATH, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- WhatsApp (Twilio) ----
# Leave all three blank to run without WhatsApp — the rest of the app is
# unaffected. See README "Connecting WhatsApp (Twilio Sandbox)" for setup.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The exact public URL Twilio will call, e.g. https://parakh-backend.onrender.com
# or your ngrok URL for local testing. Required for webhook signature
# verification; without it the webhook still runs but logs a warning and
# skips verification (fine for local testing, not for production).
PUBLIC_BASE_URL=
